                     <string notr="true">QPushButton {
    color: white;                   /* White text for contrast */
    background-color: #ea580c;      /* Medium-dark pastel orange with good contrast */
}

QPushButton:hover {
    background-color: #d35400;      /* Darker pastel orange on hover */
    border-color: #c44d00;          /* Darker border on hover */
}

QPushButton:pressed {
    background-color: #c44d00;      /* Even darker when pressed */
    border-color: #b34600;          /* Darker border when pressed */
}

QPushButton:disabled {
    background-color: #f0b27a;      /* Lighter pastel orange when disabled */
    border-color: #f0b27a;          /* Same color border for disabled */
    color: rgba(255, 255, 255, 0.7); /* Semi-transparent white text */
}</string>
