                 </font>
                </property>
                <property name="styleSheet">
                 <string notr="true">QPushButton {
    color: white;
    background-color: #fcbe11;      /* Bright saffron gold - main color */
    border: 1px solid #e3ab0f;      /* Slightly darker border */

}

QPushButton:hover {
    background-color: #e3ab0f;      /* 10% darker than main color */
    border-color: #ca980e;          /* 20% darker than main color */
}

QPushButton:pressed {
    background-color: #ca980e;      /* 20% darker than main color */
    border-color: #b1850c;          /* 30% darker than main color */
}

QPushButton:disabled {
    background-color: #fdcf55;      /* 20% lighter than main color */
    border-color: #fdcf55;          /* Same as background for cleaner disabled look */
    color: rgba(255, 255, 255, 0.7); /* Semi-transparent white */
}</string>
                </property>
                <property name="text">
